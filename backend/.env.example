PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/geniusbooks

# JWT — use a random string of at least 32 characters
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRE=7d

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=geniusbooks-content

# SMTP — for sending OTP verification emails
# Gmail example: use an App Password (not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Genius Books <your@gmail.com>"
